# Binaries
*.exe
*.out
# Anchored to the repo root so the compiled `./quark` binary is ignored
# without also matching the cmd/quark/ source tree.
/quark
/gen-apisurface
# The superapp acceptance binary (`go build ./examples/superapp`), 42 MB —
# it was committed once by accident (#312).
/superapp
blog-api
/migrations

# Example binaries: each engine example is its own module with one `main`,
# so `go build` inside it writes an executable named after the directory.
/examples/sqlite/sqlite
/examples/postgres/postgres
/examples/mysql/mysql
/examples/mssql/mssql
/examples/migrations/migrations
/examples/sharding/sharding
/examples/tenant-rls-native/tenant-rls-native

# Example database files
*.db
*.db-shm
*.db-wal

# Test artifacts
*.test
*.prof
*.trace

# Editor
.DS_Store
.idea/
.vscode/
*.swp

# Go workspace (local only)
go.work
go.work.sum

# Docusaurus build artifacts (regenerated by deploy workflow)
website/build/
website/.docusaurus/
website/node_modules/
website/test-results/

# Bug-bash run artifacts (trazabilidad local; no se versionan)
bugbash/REPORTS/

# Superapp workload run artifacts (informes/métricas/logs regenerables)
examples/superapp/REPORTS/
