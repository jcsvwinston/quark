{
  "release-type": "go",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "draft": false,
  "prerelease": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Changed"
    },
    {
      "type": "revert",
      "section": "Reverted"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chore",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
        "release-type": "go",
      "exclude-paths": [
        "examples/superapp",
        "bugbash",
        "benchmarks",
        "TASKS.md"
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "SECURITY.md"
        },
        {
          "type": "generic",
          "path": "website/docs/reference/release-notes.mdx"
        }
      ]
    },
    "drivers/mssql": {
      "package-name": "github.com/jcsvwinston/quark/drivers/mssql",
      "release-type": "go",
      "component": "drivers/mssql",
      "include-component-in-tag": true,
      "tag-separator": "/"
    },
    "drivers/mysql": {
      "package-name": "github.com/jcsvwinston/quark/drivers/mysql",
      "release-type": "go",
      "component": "drivers/mysql",
      "include-component-in-tag": true,
      "tag-separator": "/"
    },
    "drivers/oracle": {
      "package-name": "github.com/jcsvwinston/quark/drivers/oracle",
      "release-type": "go",
      "component": "drivers/oracle",
      "include-component-in-tag": true,
      "tag-separator": "/"
    },
    "drivers/postgres": {
      "package-name": "github.com/jcsvwinston/quark/drivers/postgres",
      "release-type": "go",
      "component": "drivers/postgres",
      "include-component-in-tag": true,
      "tag-separator": "/"
    },
    "drivers/sqlite": {
      "package-name": "github.com/jcsvwinston/quark/drivers/sqlite",
      "release-type": "go",
      "component": "drivers/sqlite",
      "include-component-in-tag": true,
      "tag-separator": "/"
    }
  },
  "separate-pull-requests": false
}
